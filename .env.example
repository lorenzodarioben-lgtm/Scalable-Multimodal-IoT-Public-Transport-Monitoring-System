# ---------------------------------------------------------------------------
# SIT314 multimodal transport monitoring - environment template
#
# Copy to .env and fill in. .env is git-ignored and MUST NOT be committed.
# This file contains NO real values - only names and safe defaults.
# ---------------------------------------------------------------------------

# ---- backend selection ----------------------------------------------------
# local = file-backed adapters for development and local experiments
# aws   = real SQS / DynamoDB / CloudWatch
QUEUE_BACKEND=local
STORE_BACKEND=local
METRICS_BACKEND=local

# ---- AWS ------------------------------------------------------------------
# Credentials are NEVER placed here. Use `aws configure`, an SSO profile, or -
# in ECS - the task role. Do not create IAM users or long-lived access keys.
AWS_REGION=us-east-1
RESOURCE_PREFIX=sit314-transport

# ---- MQTT -----------------------------------------------------------------
# local = plain TCP to the development broker on localhost
# aws   = MQTT over TLS 1.2 to AWS IoT Core with mutual X.509 authentication
MQTT_MODE=local
MQTT_LOCAL_HOST=localhost
MQTT_LOCAL_PORT=1883

# Required only when MQTT_MODE=aws.
# Endpoint: aws iot describe-endpoint --endpoint-type iot:Data-ATS
AWS_IOT_ENDPOINT=
AWS_IOT_PORT=8883
# Paths to certificate files stored in certs/ (git-ignored). Paths only -
# never paste certificate or key CONTENT into this file.
AWS_IOT_CA_PATH=certs/AmazonRootCA1.pem
AWS_IOT_CERT_PATH=certs/device-certificate.pem.crt
AWS_IOT_PRIVATE_KEY_PATH=certs/device-private.pem.key

# ---- business thresholds --------------------------------------------------
CROWDING_MODERATE=0.60
CROWDING_HIGH=0.85
CROWDING_CRITICAL=1.00
CROWDING_INCIDENT_LEVEL=critical
SEVERE_DELAY_SECONDS=600
MAJOR_DELAY_SECONDS=1200

# ---- worker tuning --------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_BATCH_SIZE=10
WORKER_WAIT_TIME_SECONDS=5
WORKER_VISIBILITY_TIMEOUT_SECONDS=30
QUEUE_MAX_RECEIVE_COUNT=3

# ---- documented TEST PARAMETERS (default off) -----------------------------
# Adds a controlled service time per job so queue build-up and worker scaling
# are observable at an affordable workload size. See docs/SCALABILITY_TESTING.md.
# These never change any calculated result.
WORKER_PROCESSING_DELAY_MS=0
WORKER_PROCESSING_CPU_ITERATIONS=0

# ---- failure injection (default OFF) --------------------------------------
FAILURE_INJECTION_ENABLED=false
FAILURE_RATE=0

# ---- autoscaling ----------------------------------------------------------
SCALING_MIN_TASKS=1
SCALING_MAX_TASKS=5
SCALING_TARGET_BACKLOG_PER_TASK=75
METRIC_NAMESPACE=SIT314/Transport

# ---- logging --------------------------------------------------------------
LOG_LEVEL=info
