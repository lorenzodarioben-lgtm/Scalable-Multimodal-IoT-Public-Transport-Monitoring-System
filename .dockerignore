# Never copy secrets or local state into an image.
.env
.env.*
certs/
*.pem
*.key
*.crt
credentials*

# Build/runtime noise
node_modules/
**/node_modules/
.git/
.gitignore
artifacts/
local-data/
evidence/
node-red/data/
docs/
*.log
.vscode/
.idea/

# Development-only files. The services COPY whole directories (shared/,
# services/<name>/), so without these the test suites and the Dockerfiles
# themselves ended up inside the production images. The Dockerfile is read via
# `docker build -f` from the host, not from the build context, so excluding it
# here does not affect the build.
**/test/
**/*.test.js
**/Dockerfile
**/Dockerfile.*
