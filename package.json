{
  "name": "sit314-transport-iot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multimodal public transport IoT pipeline with reactive and predictive autoscaling",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "simulator",
    "services/telemetry-processor",
    "services/route-impact-worker",
    "services/notification-worker"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec \"shared/test/*.test.js\" \"simulator/test/*.test.js\" \"node-red/test/*.test.js\" \"services/*/test/*.test.js\" \"infrastructure/test/*.test.js\" \"experiments/test/*.test.js\"",
    "test:all": "npm run test",
    "simulate": "node simulator/src/cli.js",
    "broker": "node scripts/local-broker.js",
    "bridge": "node scripts/normalized-bridge.js",
    "processor": "node services/telemetry-processor/src/index.js",
    "route-worker": "node services/route-impact-worker/src/index.js",
    "notification-worker": "node services/notification-worker/src/index.js",
    "autoscaler": "node scripts/local-autoscaler.js",
    "experiment": "node experiments/runner/run-experiment.js",
    "experiment:aws": "node experiments/aws/run-aws-experiment.js",
    "queue:stats": "node scripts/queue-stats.js",
    "state:dump": "node scripts/state-dump.js",
    "verify-env": "node scripts/verify-env.js",
    "demo:local": "node scripts/demo-local.js",
    "demo:checkpoint": "node scripts/demo-checkpoint.js",
    "demo:reliability": "node scripts/demo-reliability.js",
    "evidence": "node scripts/evidence.js",
    "test:tap": "node --test \"shared/test/*.test.js\" \"simulator/test/*.test.js\" \"node-red/test/*.test.js\" \"services/*/test/*.test.js\" \"infrastructure/test/*.test.js\" \"experiments/test/*.test.js\"",
    "lint:infra": "node scripts/lint-infra.js",
    "flows:build": "node node-red/build-flows.js",
    "flows:check": "node node-red/build-flows.js --check",
    "node-red": "node-red --settings node-red/settings.cjs --userDir node-red/data",
    "tap": "node scripts/mqtt-tap.js"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1125.0",
    "@sit314/notification-worker": "*",
    "@sit314/route-impact-worker": "*",
    "@sit314/shared": "*",
    "@sit314/simulator": "*",
    "@sit314/telemetry-processor": "*",
    "mqtt": "^5.10.1"
  },
  "devDependencies": {
    "aedes": "^0.51.3",
    "node-red": "^5.0.6",
    "yaml": "^2.9.0"
  }
}
